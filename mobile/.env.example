# Where the RideRescue backend is reachable FROM THE PHONE.
#
#   Android emulator ....... http://10.0.2.2:5000
#   iOS simulator .......... http://localhost:5000
#   Real phone on Wi-Fi .... http://<your-PC-LAN-IP>:5000   e.g. http://192.168.1.7:5000
#
# Find your PC's LAN IP with `ipconfig` (look for IPv4 Address on your Wi-Fi adapter).
EXPO_PUBLIC_API_URL=http://10.0.2.2:5000

# Google Maps JavaScript API key for the in-app map. Unset, the app falls back
# to Leaflet and OpenStreetMap.
#
# Not a secret — it ships inside the APK. Restrict it in Google Cloud Console to
# the app's package name (in.riderescue.app) and signing certificate SHA-1.
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
