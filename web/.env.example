# Copy to .env.local and adjust. .env.local is gitignored; this template is not.

# Which API the browser calls.
#   http://localhost:5000               - fully local, against your own backend
#   https://riderescue-api.onrender.com - local UI against live data
#
# NEXT_PUBLIC_* values are inlined into the client bundle at BUILD time, not read
# at runtime, so changing this needs a rebuild. On Vercel, set the same variable
# in Settings > Environment Variables and leave "Sensitive" OFF — a sensitive
# value is withheld from the client bundle, which is exactly where this has to end
# up, and the build silently falls back to localhost instead.
NEXT_PUBLIC_API_URL=http://localhost:5000

# Firebase web config for phone OTP sign-in. Optional: web/src/lib/firebase.ts
# carries working defaults for the riderescue-94e68 project, and these override
# them only if you point the app at a different Firebase project.
#
# These are NOT secrets — every Firebase web app ships them in its JavaScript by
# design. The service-account key is the real secret and lives only on the server.
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_FIREBASE_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=

# Google Maps JavaScript API key. Unset, the app falls back to Leaflet and
# OpenStreetMap, so a clone without a key still shows a map.
#
# Not a secret — it ships in the bundle and is identified by HTTP referrer.
# RESTRICT IT in Google Cloud Console (Credentials > your key > Application
# restrictions > HTTP referrers) to your own domains, or anyone who views source
# can spend your quota. Enable the "Maps JavaScript API" for the project.
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
