node_modules/
*.log

# Secrets — never commit these. .env.example files ARE committed as templates.
.env
.env.local
.env.*.local
!.env.example

# Embedded MongoDB data directory and the cached mongod binary
backend/data/

# Next.js
web/.next/
web/out/
web/next-env.d.ts

# Expo
mobile/.expo/
mobile/.expo-export/
mobile/dist/
mobile/expo-env.d.ts

# Native projects are generated by `expo prebuild` — regenerate rather than commit.
# They are large, machine-specific, and would otherwise carry a debug keystore.
mobile/android/
mobile/ios/

# Firebase client config. It ships inside the APK so it is not strictly secret,
# but it is tied to one Firebase project — each developer supplies their own.
# See README for how to regenerate it.
mobile/google-services.json
mobile/GoogleService-Info.plist

# Firebase service-account key — this one IS a secret, never commit it.
**/serviceAccountKey.json
**/firebase-adminsdk*.json

# Signing material, if you ever add a real release keystore
*.keystore
*.jks
key.properties

# Throwaway icon previews (regenerate with mobile/assets/source/preview.mjs)
mobile/assets/source/_preview-*.png

# Editors / OS
.DS_Store
Thumbs.db
.vscode/
.idea/
