# Copy to .env and adjust as needed.

# Port for the API + Socket.IO server
PORT=5000

# Leave MONGODB_URI empty to auto-start an embedded MongoDB (data persists in ./data/mongo).
# For MongoDB Atlas / local mongod, set e.g.:
# MONGODB_URI=mongodb://127.0.0.1:27017/ride_rescue
MONGODB_URI=

# JWT secret - change for production
JWT_SECRET=ride-rescue-dev-secret-change-me
JWT_EXPIRES_IN=7d

# Dev mode: OTPs are returned in API responses and printed to the console
# instead of being sent by SMS/email. Set to false when a real SMS gateway is wired in.
DEV_MODE=true

# Razorpay (optional - mock payments are used when these are empty)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
