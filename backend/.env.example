# Copy to .env and adjust as needed.

# Port for the API + Socket.IO server. Hosts like Render inject their own.
PORT=5000

# Leave MONGODB_URI empty to auto-start an embedded MongoDB (data persists in ./data/mongo).
# Set it for a local mongod or MongoDB Atlas:
#   MONGODB_URI=mongodb://127.0.0.1:27017/ride_rescue
#   MONGODB_URI=mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/ride_rescue
# REQUIRED in production - hosted disks are wiped on restart, so the embedded
# database would lose every booking and account.
MONGODB_URI=

# JWT secret. The server REFUSES to start in production while this is the
# default value. Generate one with:  node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
JWT_SECRET=ride-rescue-dev-secret-change-me
JWT_EXPIRES_IN=7d

# Dev mode: OTPs are returned in API responses and printed to the console
# instead of being sent by SMS/email, and payments settle against a mock gateway.
# Defaults to false when NODE_ENV=production - leaving it on with a public URL
# lets anyone register using OTP 123456.
DEV_MODE=true

# Comma-separated list of web origins allowed to call this API.
# Empty = any origin, which is convenient locally and too permissive in production.
#   CORS_ORIGIN=https://riderescue.vercel.app,http://localhost:3000
CORS_ORIGIN=

# Set to "production" on a deployed server. Enables the startup safety checks above.
# NODE_ENV=production

# Set SIMULATE=false to stop demo mechanics from auto-moving toward customers.
# SIMULATE=true

# Razorpay (optional - mock payments are used when these are empty)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
